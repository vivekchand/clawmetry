# ClawMetry self-hosted server image, as published to ghcr.io/vivekchand/clawmetry.
#
# This is NOT the source build. .github/workflows/container-image.yml puts the
# exact wheel PyPI serves for a release into dist/ (after checking that wheel's
# build provenance) and installs it here, so the image carries the same bytes a
# `pip install clawmetry==<version>` user gets, and nothing else from the repo.
# The repository's root Dockerfile (what docker-compose.build.yml builds) stays
# the from-source path for development.
#
# What must never be in this image: the proprietary Pro plugin. It is not on
# PyPI and nothing here fetches it; scripts/verify_selfhosted_image.py fails the
# release if a clawmetry-pro distribution or module is importable inside it.
#
# Base pinned by digest, same digest and same reasoning as the root Dockerfile;
# .github/dependabot.yml watches this directory so the pin does not rot.
FROM python:3.14-slim@sha256:51dafde81dbdb6ebde285137a295cf18a47ca95234fe388a343719cb97305b3d

ARG CLAWMETRY_VERSION=""

LABEL org.opencontainers.image.title="ClawMetry self-hosted server" \
      org.opencontainers.image.description="Dashboard, node ingest API, fleet page and audit export for a single-tenant ClawMetry deployment" \
      org.opencontainers.image.source="https://github.com/vivekchand/clawmetry" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${CLAWMETRY_VERSION}"

# Defaults for a self-hosted server. Each can be overridden at `docker run`.
#   SELF_HOSTED=true           registers the node ingest API and fleet page
#   CLAWMETRY_NO_TELEMETRY=1   no install telemetry
#   CLAWMETRY_NO_CLOUD=1       no managed-cloud sync
#   CLAWMETRY_AUTO_UPDATE=0    a signed image must never pip-install a different
#                              version into itself; upgrade by pulling a new digest
ENV PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    SELF_HOSTED=true \
    CLAWMETRY_NO_TELEMETRY=1 \
    CLAWMETRY_NO_CLOUD=1 \
    CLAWMETRY_AUTO_UPDATE=0

COPY dist/ /tmp/dist/

# The OTLP decoder, from a hash-pinned set rather than the `>=` ranges the
# [otel] extra carries. Installed BEFORE the wheel on purpose: pip then finds
# both names already satisfied and resolves neither itself, so the extra on
# the next line contributes the exact artifacts otel-requirements.txt names.
#
# The base image above is pinned by digest so an identical build pulls
# identical bytes. This is that same argument applied to the layer directly
# above it -- and it counts for more here than in the root Dockerfile, because
# this image is the one that gets signed and attested. See that file's header.
COPY otel-requirements.txt /tmp/otel-requirements.txt
RUN pip install --no-cache-dir --require-hashes -r /tmp/otel-requirements.txt \
    && rm -f /tmp/otel-requirements.txt

# clawmetry's OWN runtime dependencies, from a hash-pinned set rather than the
# open floors install_requires carries (`flask>=2.0,<4`, `duckdb>=0.10`,
# `certifi>=2024.7.4`). Installed BEFORE the wheel for the same reason as the
# layer above: pip then finds every name already satisfied and resolves none of
# them itself, so the wheel install on the next line contributes exactly the
# artifacts runtime-requirements.txt names.
#
# Without this, that one `pip install` was the only unpinned resolve left in a
# file whose base image is pinned by digest and whose OTLP layer is hash-pinned
# -- and it was the biggest of the three, at 15 packages. See that file's
# header for why it is separate from the root image's docker-runtime.txt.
COPY runtime-requirements.txt /tmp/runtime-requirements.txt
RUN pip install --no-cache-dir --require-hashes -r /tmp/runtime-requirements.txt \
    && rm -f /tmp/runtime-requirements.txt

# Exactly one clawmetry wheel, installed with the OTLP decoder extra: the
# daemon-free intake path (runtimes exporting OTLP straight to this server)
# answers 501 to http/protobuf without it.
RUN set -eu; \
    set -- /tmp/dist/clawmetry-*.whl; \
    if [ "$#" -ne 1 ] || [ ! -f "$1" ]; then \
      echo "expected exactly one clawmetry wheel in dist/, found: $*" >&2; exit 1; \
    fi; \
    pip install --no-cache-dir "$1[otel]"; \
    rm -rf /tmp/dist; \
    python3 -m pip uninstall --yes pip

# pip is removed once the wheel is in, because the image never needs it again
# (CLAWMETRY_AUTO_UPDATE=0 above) and, per trivy, it is the only thing in the
# image that carries fixable advisories. pip vendors its own copies of msgpack
# and setuptools (pip/_vendor/vendor.txt: msgpack==1.1.2, setuptools==70.3.0),
# and trivy reports them as installed packages:
#   GHSA-6v7p-g79w-8964  msgpack     1.1.2  -> 1.2.1   HIGH
#   CVE-2025-47273       setuptools  70.3.0 -> 78.1.1  HIGH
#   CVE-2026-59890       setuptools  70.3.0 -> 83.0.0  MEDIUM
# Upgrading pip does not help: the latest pip vendors the same versions.
# License activation still works without pip: license._pip_install_wheel
# bootstraps pip with ensurepip when the interpreter has it and, failing that,
# unzips the wheel into site-packages.

# HOME=/root, so the store lives in /root/.clawmetry: the volume path the
# Compose file has always mounted. Changing it would strand existing data.
WORKDIR /root

EXPOSE 8900

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8900/api/health', timeout=5)" || exit 1

CMD ["clawmetry", "--host", "0.0.0.0", "--port", "8900"]
